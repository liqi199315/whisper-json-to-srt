{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "whisper-json-to-srt",
	"compatibility_date": "2026-01-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "jsontosrt.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
