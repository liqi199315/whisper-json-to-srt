---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterWorkbench from '../components/ConverterWorkbench.astro';
import { convertAsrJson } from '../lib/subtitle-engine';
import { SAMPLE_PAYLOADS } from '../lib/sample-payloads';
import {
	FORMAT_FIELD_CARDS,
	HOW_IT_WORKS_STEPS,
	ROUTE_PRESETS,
	WORKFLOW_LINK_CARDS,
} from '../lib/route-presets';
import type { ToolRoutePreset } from '../lib/types';

export function getStaticPaths() {
	return ROUTE_PRESETS.filter((preset) => preset.slug !== '').map((preset) => ({
		params: { preset: preset.slug },
		props: { preset },
	}));
}

interface Props {
	preset: ToolRoutePreset;
}

const { preset } = Astro.props;
const guideSample = SAMPLE_PAYLOADS[preset.defaultSampleId];
const guideExport = preset.guides?.length
	? convertAsrJson(guideSample.json, preset.defaultOptions)
	: null;
---

<BaseLayout preset={preset}>
	<ConverterWorkbench preset={preset} />

	{
		preset.guides?.map((guide) => (
			<section
				id={guide.id}
				aria-labelledby={`${guide.id}-heading`}
				class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-4"
			>
				<div class="space-y-1">
					<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
						{guide.kicker}
					</p>
					<h2 id={`${guide.id}-heading`} class="text-lg sm:text-xl font-bold text-slate-950">
						{guide.heading}
					</h2>
				</div>
				{guide.paragraphs.map((paragraph) => (
					<p class="text-sm text-slate-700 leading-relaxed">{paragraph}</p>
				))}
				{guide.bullets && (
					<ul class="space-y-2 text-sm text-slate-700 leading-relaxed list-disc pl-5">
						{guide.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				)}
				{guide.code && (
					<div class="space-y-2 min-w-0">
						<p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
							{guide.code.label}
						</p>
						<pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-xl bg-slate-950 p-4 text-xs leading-relaxed text-slate-100"><code>{guide.code.source}</code></pre>
					</div>
				)}
				{guide.links && (
					<ul class="flex flex-col gap-2 text-sm">
						{guide.links.map((link) => (
							<li>
								<a
									href={link.href}
									class="font-semibold text-sky-800 underline underline-offset-4"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		))
	}

	{
		guideExport?.ok && (
			<section
				aria-labelledby="expected-output-heading"
				class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-4"
			>
				<div class="space-y-1">
					<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
						Expected output
					</p>
					<h2 id="expected-output-heading" class="text-lg sm:text-xl font-bold text-slate-950">
						SRT this sample exports before you edit the controls
					</h2>
					<p class="text-sm text-slate-700 leading-relaxed">
						Generated in the page build from {guideSample.filename} with the preset line width,
						speaker switch, and format. The same text is already in the output box. Copy or
						download it to record a subtitle_export, or change a control and export again.
					</p>
				</div>
				<pre
					data-testid="expected-srt"
					class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-xs leading-relaxed text-slate-900"
				><code>{guideExport.output}</code></pre>
			</section>
		)
	}

	<section aria-labelledby="how-it-works-heading" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5">
		<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
			<div class="space-y-1">
				<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
					Browser-Local Pipeline
				</p>
				<h2 id="how-it-works-heading" class="text-lg sm:text-xl font-bold text-slate-950">
					How It Works in 3 Steps
				</h2>
			</div>
			<p class="text-xs sm:text-sm text-slate-600">
				Pre-tuned for {preset.navLabel} with instant client-side conversion and zero file size caps.
			</p>
		</div>

		<ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
			{
				HOW_IT_WORKS_STEPS.map((item) => (
					<li class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5 space-y-2.5">
						<div class="flex items-center gap-2.5">
							<span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-slate-900 font-mono text-xs font-bold text-sky-400">
								{item.step}
							</span>
							<h3 class="text-sm sm:text-base font-bold text-slate-950">{item.title}</h3>
						</div>
						<p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.detail}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section aria-labelledby="schema-notes-heading" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5">
		<div class="space-y-1">
			<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
				Preset Specification &amp; Field Mapping
			</p>
			<h2 id="schema-notes-heading" class="text-lg sm:text-xl font-bold text-slate-950">
				JSON Schema Notes &amp; Format Field Reference for {preset.navLabel}
			</h2>
			<p class="text-sm text-slate-600">
				Detailed parser behavior for this workflow alongside field references for every supported speech-to-text JSON dialect.
			</p>
		</div>

		<div class="rounded-xl border border-sky-200/80 bg-sky-50/40 p-4 sm:p-5 space-y-3">
			<h3 class="text-sm sm:text-base font-bold text-slate-950">
				Active preset rules ({preset.path})
			</h3>
			<ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed list-disc pl-5">
				{preset.schemaNotes.map((note) => <li>{note}</li>)}
			</ul>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{
				FORMAT_FIELD_CARDS.map((card) => (
					<article class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5 flex flex-col justify-between gap-3">
						<div class="space-y-2.5">
							<div class="flex flex-wrap items-center justify-between gap-2">
								<span class="rounded-md bg-slate-900 px-2 py-0.5 font-mono text-[11px] font-semibold text-sky-300">
									{card.tag}
								</span>
								<span class="font-mono text-[11px] text-slate-500">{card.timingUnit}</span>
							</div>
							<h3 class="text-sm sm:text-base font-bold text-slate-950">{card.title}</h3>
							<ul class="space-y-1 rounded-lg border border-slate-200/90 bg-white p-2.5 font-mono text-[11px] text-slate-800">
								{card.keyPaths.map((keyPath) => (
									<li class="break-words">{keyPath}</li>
								))}
							</ul>
						</div>
						<p class="text-xs text-slate-600 leading-relaxed">{card.behaviorNote}</p>
					</article>
				))
			}
		</div>
	</section>

	<section aria-labelledby="related-workflows-heading" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5">
		<div class="space-y-1">
			<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
				Internal Subtitle Tool Matrix
			</p>
			<h2 id="related-workflows-heading" class="text-lg sm:text-xl font-bold text-slate-950">
				Related Subtitle Workflows
			</h2>
			<p class="text-sm text-slate-600">
				Switch between the specialized subtitle converters. Each one preloads a real sample, line width, speaker setting, and export format.
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{
				WORKFLOW_LINK_CARDS.map((card) => {
					const isCurrent = card.slug === preset.slug;
					return (
						<a
							href={card.path}
							aria-current={isCurrent ? 'page' : undefined}
							class:list={[
								'group rounded-xl border p-4 sm:p-5 flex flex-col justify-between gap-3 transition-colors min-h-28',
								isCurrent
									? 'border-sky-300 bg-sky-50/50'
									: 'border-slate-200 bg-white hover:border-sky-400 hover:bg-slate-50/70',
							]}
						>
							<div class="space-y-2">
								<div class="flex flex-wrap items-center justify-between gap-2">
									<span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700">
										{card.badge}
									</span>
									{isCurrent && (
										<span class="text-[11px] font-mono font-semibold text-sky-800">
											Current view
										</span>
									)}
								</div>
								<h3 class="text-sm sm:text-base font-bold text-slate-950 group-hover:text-sky-700 transition-colors">
									{card.anchorText}
								</h3>
								<p class="text-xs text-slate-600 leading-relaxed">{card.summary}</p>
							</div>
							<div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2 text-xs">
								<code class="font-mono text-[11px] text-slate-700">{card.presetConfig}</code>
								<span class="font-semibold text-sky-700 group-hover:translate-x-0.5 transition-transform">
									Open tool -&gt;
								</span>
							</div>
						</a>
					);
				})
			}
		</div>
	</section>

	<section aria-labelledby="faq-heading" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5">
		<h2 id="faq-heading" class="text-lg sm:text-xl font-bold text-slate-950">
			Technical FAQ for {preset.primaryKeyword}
		</h2>
		<dl class="divide-y divide-slate-100">
			{
				preset.faqs.map((item) => (
					<div class="py-4 first:pt-0 last:pb-0 space-y-1.5">
						<dt class="text-sm sm:text-base font-semibold text-slate-900">{item.question}</dt>
						<dd class="text-sm text-slate-600 leading-relaxed">{item.answer}</dd>
					</div>
				))
			}
		</dl>
	</section>
</BaseLayout>
