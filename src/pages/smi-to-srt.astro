---
import BaseLayout from '../layouts/BaseLayout.astro';
import RareFormatWorkbench from '../components/RareFormatWorkbench.astro';
import type { RouteFaqItem } from '../lib/types';

const faqs: RouteFaqItem[] = [
	{
		question: 'Does SAMI to SRT conversion upload my Korean captions?',
		answer:
			'No. The .smi file is decoded with the browser File.text() API and every SYNC block is parsed in local tab memory. There is no upload endpoint, no cloud queue, and no file size limit, so client recordings, drama subtitle packs, and training material stay on your machine. The analytics event only records that a copy or download happened and which output format was used.',
	},
	{
		question: 'How are SAMI SYNC Start blocks converted into cue start and end times?',
		answer:
			'Each SYNC Start value is read as milliseconds and becomes the start of the next cue. A cue ends at the next SYNC marker, so the visible text stays on screen until the following block replaces it. When a file ends without a closing marker the last cue receives a short three second tail. Markers without a readable numeric start are skipped and reported in the status banner.',
	},
	{
		question: 'What happens to empty P elements and nbsp end markers in a SAMI file?',
		answer:
			'A SYNC block whose paragraph only contains a non-breaking space decodes to empty text, so no cue is emitted for it. That marker still closes the previous cue at its timestamp, which is exactly what players use to clear the screen. Empty blocks are dropped silently instead of becoming blank subtitles in the exported SRT.',
	},
	{
		question: 'Why does my .smi file show garbled Korean or CJK text?',
		answer:
			'Most legacy SAMI files were saved as CP949, EUC-KR, Shift_JIS, or Windows-1252 while the page is read as UTF-8, which turns Hangul and CJK characters into mojibake before parsing starts. Repair the text encoding first with the Fix subtitle encoding tool, then paste the repaired text here. The parser itself handles Hangul, Han, Kana, and full width punctuation without changing the characters.',
	},
	{
		question: 'Can I convert .smi to WebVTT for an HTML5 player, and what about multi language tracks?',
		answer:
			'Yes. Choose WebVTT in the output format selector and the track is written with a WEBVTT header and dot millisecond separators. SAMI files that pack two language classes inside the same SYNC block are flattened into one cue per marker, so split the languages into separate files first if you need two independent tracks.',
	},
];

const relatedTools = [
	{
		href: '/',
		label: 'Whisper JSON to SRT',
		detail: 'Turn OpenAI Whisper, WhisperX, and whisper.cpp JSON transcripts into timed subtitles.',
	},
	{
		href: '/ttml-to-srt/',
		label: 'TTML and DFXP to SRT',
		detail: 'Convert XML caption tracks with frame, tick, and clock timing in the browser.',
	},
	{
		href: '/fix-subtitle-encoding/',
		label: 'Fix subtitle encoding',
		detail: 'Repair mojibake from CP949, Shift_JIS, GB18030, and Windows-1252 caption files.',
	},
	{
		href: '/merge-subtitles/',
		label: 'Merge subtitle files',
		detail: 'Combine two subtitle tracks into one timeline with duplicate and overlap checks.',
	},
	{
		href: '/srt-to-json/',
		label: 'SRT to JSON',
		detail: 'Convert SRT or WebVTT cues into structured JSON for apps, tests, and pipelines.',
	},
];

const smiInputSample = `<SAMI>
<BODY>
<SYNC Start=0><P Class=ENCC>Welcome to the harbor walk.</P></SYNC>
<SYNC Start=3500><P Class=ENCC>We start at the ferry pier<br>and follow the promenade.</P></SYNC>
<SYNC Start=7200><P Class=ENCC>&nbsp;</P></SYNC>
</BODY>
</SAMI>`;

const smiOutputSample = `1
00:00:00,000 --> 00:00:03,500
Welcome to the harbor walk.

2
00:00:03,500 --> 00:00:07,200
We start at the ferry pier
and follow the promenade.`;

const koreanSample = `<SYNC Start=1200><P Class=KRCC>항구의 오래된 산책로에
오신 것을 환영합니다.</P></SYNC>`;
---

<BaseLayout
	title="SAMI (.smi) to SRT & VTT Converter | Browser-Local Caption Tool"
	description="Convert SAMI .smi caption files into clean SRT or VTT cues in your browser. SYNC blocks, empty end markers, and Korean or CJK text stay on your device with zero upload."
	canonicalPath="/smi-to-srt/"
	faqs={faqs}
>
	<div class="space-y-8 min-w-0">
		<section
			aria-labelledby="smi-hero-heading"
			class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start min-w-0"
		>
			<div class="lg:col-span-7 space-y-3 min-w-0">
				<div
					class="inline-flex flex-wrap items-center gap-2 rounded-full bg-sky-50 border border-sky-200 px-3 py-1 text-xs font-medium text-sky-900"
				>
					<span>Zero server upload</span>
					<span class="text-sky-400">/</span>
					<span>No file size cap</span>
					<span class="text-sky-400">/</span>
					<span>Local timing review</span>
				</div>
				<h1
					id="smi-hero-heading"
					class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-950 break-words"
				>
					SAMI (.smi) to SRT &amp; VTT Converter (Plus SBV, LRC &amp; ASS)
				</h1>
				<p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl break-words">
					Drop a SAMI caption file and get a clean SubRip or WebVTT track without sending it
					to a server. SYNC start values become cue times, display clearing markers are dropped,
					and every exported cue is reflowed to your line width before download.
				</p>
				<p class="text-sm text-slate-600 leading-relaxed break-words">
					The same workbench also reads SBV, LRC, ASS, SSA, TTML, DFXP, SRT, and WebVTT text,
					which helps when a Korean caption pack mixes .smi files with other text tracks.
				</p>
			</div>

			<aside
				aria-label="Quick technical specification"
				class="lg:col-span-5 w-full min-w-0 rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-xs space-y-3"
			>
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
						Technical summary
					</h2>
					<span class="font-mono text-xs text-slate-500">/smi-to-srt/</span>
				</div>
				<dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2.5 text-xs">
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">Accepted text inputs</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							SAMI, TTML, DFXP, SBV, LRC, ASS, SSA, SRT, WebVTT
						</dd>
					</div>
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">Output formats</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							SubRip (.srt) and WebVTT (.vtt)
						</dd>
					</div>
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">SAMI timing</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							SYNC Start milliseconds, next marker closes the cue, three second tail at end of file
						</dd>
					</div>
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">Text handling</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							br line breaks, entity decoding, inline tag removal, empty block dropping
						</dd>
					</div>
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">Execution and privacy</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							File.text() in local tab memory, no upload, no file size cap
						</dd>
					</div>
					<div class="min-w-0">
						<dt class="font-semibold text-slate-900">Quality gates</dt>
						<dd class="text-slate-600 mt-0.5 break-words">
							Timeline QC summary, issue list, and .qc.txt report
						</dd>
					</div>
				</dl>
			</aside>
		</section>

		<RareFormatWorkbench defaultSample="smi" />

		<section
			aria-labelledby="smi-sync-heading"
			class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-4 min-w-0"
		>
			<div class="space-y-1">
				<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
					SAMI block parsing
				</p>
				<h2 id="smi-sync-heading" class="text-lg sm:text-xl font-bold text-slate-950">
					How SAMI SYNC blocks and empty end markers become clean SRT cues
				</h2>
			</div>
			<p class="text-sm text-slate-700 leading-relaxed break-words">
				A SAMI file is a sequence of
				<code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded break-all">&lt;SYNC Start=ms&gt;</code>
				markers. The parser reads each numeric Start value as milliseconds, collects the caption body up
				to the next marker, strips tags, turns br elements into line breaks, and decodes entities. That
				means a marker at 3500 becomes the cue that starts at 00:00:03,500, and its text ends when the
				following marker appears.
			</p>
			<ul class="space-y-2 text-sm text-slate-700 leading-relaxed list-disc pl-5 break-words">
				<li>
					<strong>End markers:</strong> a block that only holds a non-breaking space becomes empty text
					after decoding, so it clears the screen at its timestamp but never becomes a blank cue in the
					exported file.
				</li>
				<li>
					<strong>File end:</strong> when the last SYNC block has no following marker, the cue receives
					a three second tail so the final line does not vanish instantly.
				</li>
				<li>
					<strong>Unreadable markers:</strong> a SYNC tag without a numeric start is skipped and counted
					in the parser warning line of the status banner.
				</li>
				<li>
					<strong>Style classes:</strong> Class and style attributes are ignored because SRT and WebVTT
					carry text and timing only, while the cue text itself is preserved.
				</li>
			</ul>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 min-w-0">
				<div class="space-y-2 min-w-0">
					<p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
						SAMI input with a display clearing marker
					</p>
					<pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-xl bg-slate-950 p-4 text-xs leading-relaxed text-slate-100"><code>{smiInputSample}</code></pre>
				</div>
				<div class="space-y-2 min-w-0">
					<p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
						SRT output after the same conversion
					</p>
					<pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-xs leading-relaxed text-slate-900"><code>{smiOutputSample}</code></pre>
				</div>
			</div>
		</section>

		<section
			aria-labelledby="smi-encoding-heading"
			class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-4 min-w-0"
		>
			<div class="space-y-1">
				<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
					Korean and CJK captions
				</p>
				<h2 id="smi-encoding-heading" class="text-lg sm:text-xl font-bold text-slate-950">
					Fixing garbled Korean or CJK .smi files
				</h2>
			</div>
			<p class="text-sm text-slate-700 leading-relaxed break-words">
				Older SAMI caption packs are often saved as CP949 or EUC-KR, and some Japanese releases use
				Shift_JIS. When those bytes are read as UTF-8, Hangul, Han, and Kana characters arrive as
				replacement characters or stray Latin symbols before the parser ever sees a SYNC tag. Repair the
				byte layer first, then convert the timing layer here:
			</p>
			<ol class="space-y-2 text-sm text-slate-700 leading-relaxed list-decimal pl-5 break-words">
				<li>
					Open <a href="/fix-subtitle-encoding/" class="font-semibold text-sky-800 underline underline-offset-4">Fix subtitle encoding</a>
					and drop the original .smi file so the bytes are re-decoded with the correct legacy codec.
				</li>
				<li>Copy the repaired text and paste it into this workbench, or save it and drop the repaired file here.</li>
				<li>Export SRT or VTT, then read the Timeline QC panel before delivery.</li>
			</ol>
			<div class="space-y-2 min-w-0">
				<p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
					Korean SYNC block after the encoding repair
				</p>
				<pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-xl bg-slate-950 p-4 text-xs leading-relaxed text-slate-100"><code>{koreanSample}</code></pre>
			</div>
			<p class="text-sm text-slate-700 leading-relaxed break-words">
				Once the text is valid, the parser treats Hangul, Han, Kana, and full width punctuation as normal
				caption characters. Long Korean cues can use a wider characters per line setting because each
				syllable occupies about twice the visual width of a Latin letter in most subtitle renderers.
			</p>
		</section>

		<section
			aria-labelledby="smi-scope-heading"
			class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5 sm:p-7 shadow-xs space-y-3 min-w-0"
		>
			<div class="space-y-1">
				<p class="text-xs font-mono font-semibold uppercase tracking-wider text-amber-800">
					Scope note
				</p>
				<h2 id="smi-scope-heading" class="text-lg sm:text-xl font-bold text-slate-950">
					Text based subtitle formats only, no bitmap OCR
				</h2>
			</div>
			<p class="text-sm text-slate-700 leading-relaxed break-words">
				SAMI stores caption text as characters, so a .smi file can be rebuilt into SRT or VTT with
				exact timing. Bitmap formats such as SUP, PGS, and VobSub store pictures of text and need an
				optical character recognition model before any cue text exists. This tool does not run OCR and
				does not send the file to a service that does. Binary input is rejected with an explicit message
				so the result is never a silently empty subtitle file.
			</p>
		</section>

		<section
			aria-labelledby="smi-related-heading"
			class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5 min-w-0"
		>
			<div class="space-y-1">
				<p class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
					Related tools
				</p>
				<h2 id="smi-related-heading" class="text-lg sm:text-xl font-bold text-slate-950">
					Keep working with the same local engine
				</h2>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 min-w-0">
				{
					relatedTools.map((tool) => (
						<a
							href={tool.href}
							class="group rounded-xl border border-slate-200 bg-white p-4 flex flex-col gap-1.5 transition-colors hover:border-sky-400 hover:bg-slate-50/70 min-w-0"
						>
							<h3 class="text-sm font-bold text-slate-950 group-hover:text-sky-700 transition-colors break-words">
								{tool.label}
							</h3>
							<p class="text-xs text-slate-600 leading-relaxed break-words">{tool.detail}</p>
							<span class="mt-1 text-xs font-semibold text-sky-700">Open tool -&gt;</span>
						</a>
					))
				}
			</div>
		</section>

		<section
			aria-labelledby="smi-faq-heading"
			class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-xs space-y-5 min-w-0"
		>
			<h2 id="smi-faq-heading" class="text-lg sm:text-xl font-bold text-slate-950">
				SAMI to SRT questions
			</h2>
			<dl class="divide-y divide-slate-100">
				{
					faqs.map((item) => (
						<div class="py-4 first:pt-0 last:pb-0 space-y-1.5 min-w-0">
							<dt class="text-sm sm:text-base font-semibold text-slate-900 break-words">
								{item.question}
							</dt>
							<dd class="text-sm text-slate-600 leading-relaxed break-words">{item.answer}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>
</BaseLayout>
